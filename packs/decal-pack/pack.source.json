    },
    {
      "id": "jig-task-ledger",
      "scope": "consumer",
      "providers": ["jig"],
      "required": false
    }
  ],
  "executionPolicies": {
    "repositoryAuthority": {
      "schemaVersion": 1,
      "identityProbe": "root-and-product-identity-only",
      "crossProjectAccess": "explicit-current-user-approval",
      "approvalBinding": ["repository-root", "operation-scope", "current-task"],
      "separateAuthorities": ["commit", "push", "deploy", "delete"]
    },
    "settlementCommit": {
      "schemaVersion": 1,
      "decalOwnedSession": "native-atomic-transaction",
      "externalHost": "explicit-settlement-request-authorizes-exact-settlement-commit",
      "finalizerRequired": true,
      "pushIncluded": false
    },
    "taskRegistryInitialization": {
      "schemaVersion": 1,
      "mode": "explicit-only",
      "writer": "contracts/task-work-bug/initialize-task-registry.mjs",
      "approvalBinding": ["repository-root", "operation-scope", "current-task"],
      "automaticInstall": false
    }
  },
