        "codex": "skills/{skillId}/SKILL.md",
        "claude": ".claude/skills/{skillId}/SKILL.md",
        "gemini": ".gemini/skills/{skillId}/SKILL.md",
        "acp": ".agents/skills/{skillId}/SKILL.md"
      }
    },
    "agentSkills": {
      "sourcePrefix": "src/skills/agents/",
      "targets": {
        "codex": "skills/{relativePath}",
        "claude": ".claude/skills/{relativePath}",
        "gemini": ".gemini/skills/{relativePath}",
        "acp": ".agents/skills/{relativePath}"
      }
    },
    "contracts": {
      "sourcePrefix": "src/contracts/",
      "target": "contracts/{relativePath}",
      "moduleId": "task-work-bug"
    },
    "vendorNotices": {
      "sourcePrefix": "src/vendor/",
      "target": "docs/skills/vendor/{relativePath}",
