{
  "schema": "zuz.its.owned-text-edit/v22",
  "operations": {
    "owned-edit": {
      "supported": true,
      "host": "portable",
      "phases": [
        "capture",
        "apply",
        "preview",
        "commit",
        "inspect"
      ],
      "requires": [
        "officialBeforeAfterCapture",
        "activeTaskRevision",
        "independentTextChange",
        "unchangedHeadAndTarget",
        "approvalDigest",
        "isolatedIndex",
        "noHooks"
      ],
      "settlement": false
    }
  },
  "limits": {
    "textUtf8Bytes": 1048576,
    "sealedReceiptUtf8Bytes": 4194304,
    "invalidUnicode": "reject",
    "nul": "reject",
    "oversize": "reject-before-write"
  },
  "nativeAdapter": "host-advertised-only",
  "platforms": [
    "darwin",
    "linux",
    "win32"
  ],
  "storageProtection": {
    "posix": "owner-only mode",
    "win32": "owner-only DACL, created before secrets"
  }
}
