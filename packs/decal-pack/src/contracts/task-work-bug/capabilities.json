{
  "schema": "decal.task-work-bug.capabilities/v1",
  "note": "Each capability names one default contract and optional explicit platformContracts. its-register.mjs selects only the current platform entry, verifies it, and never falls back or searches for the latest folder.",
  "capabilities": {
    "register-task-batch": {
      "contract": "v15",
      "entry": "register-task-batch.mjs",
      "platformContracts": {
        "win32": "v25"
      }
    },
    "register-ticket": {
      "contract": "v15",
      "entry": "register-ticket.mjs",
      "platformContracts": {
        "win32": "v25"
      }
    },
    "register-incident": {
      "contract": "v16",
      "entry": "register-ticket.mjs",
      "platformContracts": {
        "win32": "v26"
      }
    },
    "register-via-authority": {
      "contract": "v24",
      "entry": "lan-client.mjs"
    },
    "detect-authority": {
      "contract": "v24",
      "entry": "lan-discovery.mjs"
    },
    "check-task-version-policy": {
      "contract": "v27",
      "entry": "task-version-policy.mjs"
    },
    "acquire-registration-lock": {
      "contract": "v15",
      "entry": "registration-lock.mjs",
      "platformContracts": {
        "win32": "v25"
      }
    },
    "resolve-main-authority": {
      "contract": "v10",
      "entry": "main-authority.mjs"
    }
  }
}
